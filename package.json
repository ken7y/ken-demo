{
  "name": "recall-interview",
  "version": "1.0.0",
  "private": true,
  "description": "Boilerplate full-stack application showcasing the Recall API",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "backend": "pnpm --filter backend dev",
    "frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules"
  },
  "keywords": [
    "recall",
    "api",
    "boilerplate",
    "full-stack"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
