# Server
PORT=3001
NODE_ENV=development

# Recall API
RECALL_API_KEY=your_recall_api_key_here
RECALL_REGION=us-west-2

# ngrok (run `ngrok http 3001` and paste the domain here — no https://)
NGROK_DOMAIN=your_ngrok_domain_here

# Webhook signing secret (from Recall dashboard → Webhooks, starts with whsec_)
WEBHOOK_TOKEN=your_whsec_secret_here

# CORS
CORS_ORIGIN=http://localhost:5173
